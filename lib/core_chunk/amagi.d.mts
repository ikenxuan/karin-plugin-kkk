  paginate?: PaginateDef<zod.infer<TParams>>;
  /** 多请求聚合 / 分段并发时的部分失败语义，默认 `'fail'` */
  partial?: PartialPolicy;
  /** 平台响应判定。缺省用所在平台的默认 judge */
  judge?: Judge;
