  /** 尺寸信息。注意 `width` / `height` 实测恒为 0，真实尺寸看 `thumbWidth` / `thumbHeight` */
  layout?: {
    width?: number;
    height?: number;
    thumbWidth?: number;
    thumbHeight?: number;
    [property: string]: any;
  };
  content?: {
    /** 图片直链，多 CDN 备份 */
    smallUrl?: KsCdnUrl[];
    /** 被引用作品的元信息 */
    photoInfo?: {
      userName?: string;
      /** 来源标记，如 `LIKE_TAB`（来自用户的点赞收藏） */
      photoSource?: string;
      photoId?: string;
      photoType?: number;
      serverExpTag?: string;
      [property: string]: any;
    };
    [property: string]: any;
  };
  [property: string]: any;
};
/** CDN 地址项。快手的多 CDN 字段（`headurls` / `smallUrl` / `audioUrls` …）都是这个形状 */
type KsCdnUrl = {
  cdn?: string;
  url?: string;
  [property: string]: any;
};
