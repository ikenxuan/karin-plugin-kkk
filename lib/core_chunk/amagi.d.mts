  platform: Platform;
  /** 会话 cookie（申请二维码时的那一份） */
  cookie: string;
  /** 轮询令牌（抖音 token / B站 qrcode_key） */
  token?: string;
  /** 二维码（start 之后一直带着） */
  qrcode?: Qrcode;
  /** 调用方请求配置（代理、超时、额外请求头） */
